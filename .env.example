# Anthropic (server-side only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Supabase (Connect button → Project URL; Settings → API Keys for the two keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_...  (safe in the browser)
SUPABASE_SECRET_KEY=                    # sb_secret_...       (server only, never share)

# Rate limits for /api/plan
PLAN_LIMIT_PER_IP_PER_DAY=5
PLAN_LIMIT_GLOBAL_PER_DAY=200
RATE_LIMIT_SALT=change-me-to-a-random-string
